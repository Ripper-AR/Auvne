{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/atelier",
        "destination": "/atelier/index.html"
      }
    ],
    "predeploy": [
      "npm run build"
    ]
  }
}
